{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "command-raw",
    "source": "test -r \"$HOME/.face\" && exec chafa --format symbols --symbols block --colors full --size 30x15 -- \"$HOME/.face\""
  },
  "display": {
    "color": {
      "keys": "#bd93f9",
      "title": "#ff79c6"
    },
    "percent": {
      "color": {
        "green": "#8be9fd",
        "yellow": "#b586f8",
        "red": "#ff5555"
      }
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "OS",
      "format": "Arch Linux x86_64"
    },
    "host",
    "bios",
    "bootmgr",
    "board",
    "kernel",
    "packages",
    "shell",
    "display",
    "wm",
    "icons",
    "font",
    "cursor",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "battery",
    "publicip",
    "localip",
    "locale"
  ]
}
