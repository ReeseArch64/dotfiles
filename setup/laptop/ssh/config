# ==============================
# CONFIGURAÇÃO GLOBAL
# ==============================
Host *
  AddKeysToAgent yes
  IdentitiesOnly yes

  PreferredAuthentications publickey
  PasswordAuthentication no
  KbdInteractiveAuthentication no
  PubkeyAuthentication yes

  ForwardAgent no
  ForwardX11 no
  ClearAllForwardings yes

  ConnectTimeout 10
  ServerAliveInterval 30
  ServerAliveCountMax 3
  TCPKeepAlive no

  StrictHostKeyChecking yes
  UpdateHostKeys yes
  HashKnownHosts yes

  ControlMaster no
  ControlPath none
  ControlPersist no

  SendEnv -
  RequestTTY no
  LogLevel INFO

# ==============================
# GITHUB
# ==============================
Host github.com
  HostName github.com
  User git
  Port 22
  IdentitiesOnly yes
  ForwardAgent no
  IdentityFile ~/.ssh/id_github

# ==============================
# GITLAB
# ==============================
Host gitlab.com
  HostName gitlab.com
  Port 22
  IdentitiesOnly yes
  ForwardAgent no
  User git
  IdentityFile ~/.ssh/id_gitlab

