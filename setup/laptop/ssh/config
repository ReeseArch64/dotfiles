# ==============================
# CONFIGURAÇÃO GLOBAL
# ==============================
Host *
  AddKeysToAgent yes
  IdentityAgent /run/user/%i/ssh-agent.socket
  IdentitiesOnly yes

  PreferredAuthentications publickey

  LogLevel INFO

  StrictHostKeyChecking yes
  UpdateHostKeys yes
  HashKnownHosts yes

  TCPKeepAlive no

  ServerAliveCountMax 3
  ServerAliveInterval 30

  KbdInteractiveAuthentication no

  ControlPersist no
  ControlPath none
  ControlMaster no

# ==============================
# GITHUB
# ==============================
Host github.com
  HostName github.com
  User git
  Port 22
  IdentitiesOnly yes
  ForwardAgent no
  IdentityFile ~/.ssh/id_github

# ==============================
# GITLAB
# ==============================
Host gitlab.com
  HostName gitlab.com
  Port 22
  IdentitiesOnly yes
  ForwardAgent no
  User git
  IdentityFile ~/.ssh/id_gitlab
