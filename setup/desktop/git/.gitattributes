###############################################################################
# Global .gitattributes
# Uso:
#   git config --global core.attributesFile ~/.gitattributes
###############################################################################

###############################################################################
# Default
###############################################################################

* text=auto

###############################################################################
# Line endings
###############################################################################

*.sh          text eol=lf
*.bash        text eol=lf
*.zsh         text eol=lf
*.fish        text eol=lf

*.c           text
*.h           text
*.cpp         text
*.hpp         text
*.cc          text
*.hh          text

*.cs          text
*.java        text
*.kt          text
*.kts         text
*.scala       text
*.groovy      text

*.js          text
*.jsx         text
*.mjs         text
*.cjs         text
*.ts          text
*.tsx         text

*.py          text
*.rb          text
*.php         text
*.go          text
*.rs          text
*.swift       text
*.zig         text
*.lua         text
*.r           text

*.html        text
*.htm         text
*.css         text
*.scss        text
*.sass        text
*.less        text

*.xml         text
*.xsd         text
*.xsl         text

*.json        text
*.jsonc       text
*.yaml        text
*.yml         text
*.toml        text
*.ini         text
*.cfg         text
*.conf        text
*.properties  text

*.md          text
*.markdown    text
*.txt         text
*.rst         text
*.adoc        text
*.tex         text
*.csv         text
*.tsv         text

###############################################################################
# Windows-specific
###############################################################################

*.bat         text eol=crlf
*.cmd         text eol=crlf
*.ps1         text eol=crlf
*.psm1        text eol=crlf

###############################################################################
# Git-related
###############################################################################

.gitignore    text
.gitattributes text
.editorconfig text

###############################################################################
# Diff drivers
###############################################################################

*.md          diff=markdown
*.markdown    diff=markdown

*.json        diff=json
*.jsonc       diff=json

*.yaml        diff
*.yml         diff

*.toml        diff

