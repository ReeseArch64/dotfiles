# ==============================
# CONFIGURAÇÃO GLOBAL
# ==============================
Host *
  AddKeysToAgent yes
  IdentitiesOnly yes

  PreferredAuthentications publickey
  PasswordAuthentication no
  KbdInteractiveAuthentication no
  PubkeyAuthentication yes

  ForwardAgent no
  ForwardX11 no
  ClearAllForwardings yes

  ConnectTimeout 10
  ServerAliveInterval 30
  ServerAliveCountMax 3
  TCPKeepAlive no

  StrictHostKeyChecking yes
  UpdateHostKeys yes
  HashKnownHosts yes

  ControlMaster no
  ControlPath none
  ControlPersist no

  SendEnv -
  RequestTTY no
  LogLevel INFO

