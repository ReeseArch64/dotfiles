# ==============================
# CONFIGURAÇÃO GLOBAL
# ==============================
Host *
  AddKeysToAgent yes
  IdentityAgent /run/user/%i/ssh-agent.socket
  IdentitiesOnly yes

  PreferredAuthentications publickey

  LogLevel INFO

  UpdateHostKeys yes
  HashKnownHosts yes

  TCPKeepAlive no

  ServerAliveCountMax 3
  ServerAliveInterval 30

  KbdInteractiveAuthentication no

  ControlPersist no
  ControlPath none
  ControlMaster no

# ==============================
# NOTEBOOK
# ==============================
Host notebook 192.168.1.103
  HostName 192.168.1.103
  User alsgy
  IdentityFile ~/.ssh/id_trabalho_desktop
  IdentitiesOnly yes

# ==============================
# HOMELAB
# ==============================
Host homelab
  HostName 192.168.1.107
  User alsgy
  IdentityFile ~/.ssh/id_pessoal_desktop
  IdentitiesOnly yes

# ==============================
# HOMEPROD
# ==============================
Host homeprod
  HostName ***.**.***.**
  User alsgy
  IdentityFile ~/.ssh/id_pessoal_desktop
  IdentitiesOnly yes

# ==============================
# GITHUB
# ==============================
Host github.com
  HostName github.com
  User git
  Port 22
  IdentitiesOnly yes
  ForwardAgent no
  IdentityFile ~/.ssh/id_github

# ==============================
# GITLAB
# ==============================
Host gitlab.com
  HostName gitlab.com
  Port 22
  IdentitiesOnly yes
  ForwardAgent no
  User git
  IdentityFile ~/.ssh/id_gitlab

# ==============================
# GITEA
# ==============================
Host gitea
  HostName 192.168.1.107
  User git
  Port 2222
  IdentitiesOnly yes
  ForwardAgent no
  IdentityFile ~/.ssh/id_gitea
