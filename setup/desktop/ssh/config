# Hosts LAN gerenciados usam TOFU: a primeira chave é salva e mudanças futuras
# continuam sendo recusadas.
Host 192.168.1.103 192.168.1.107
  StrictHostKeyChecking accept-new

# ==============================
# CONFIGURAÇÃO GLOBAL
# ==============================
Host *
  AddKeysToAgent yes
  IdentityAgent ${XDG_RUNTIME_DIR}/ssh-agent.socket
  IdentitiesOnly yes

  PreferredAuthentications publickey
  PasswordAuthentication no
  KbdInteractiveAuthentication no
  PubkeyAuthentication yes

  ForwardAgent no
  ForwardX11 no
  ClearAllForwardings yes

  ConnectTimeout 10
  ServerAliveInterval 30
  ServerAliveCountMax 3
  TCPKeepAlive no

  StrictHostKeyChecking yes
  UpdateHostKeys yes
  HashKnownHosts yes

  ControlMaster no
  ControlPath none
  ControlPersist no

  SendEnv -
  RequestTTY no
  LogLevel INFO

# ==============================
# SSH NOTEBOOK
# ==============================
Host 192.168.1.103
  HostName 192.168.1.103
  User alsgy
  IdentityFile ~/.ssh/id_trabalho_desktop
  IdentitiesOnly yes

# ==============================
# SSH HOMELAB
# ==============================
Host 192.168.1.107
  HostName 192.168.1.107
  User alsgy
  IdentityFile ~/.ssh/id_pessoal_desktop
  IdentitiesOnly yes

# ==============================
# GITHUB
# ==============================
Host github.com
  HostName github.com
  User git
  Port 22
  IdentitiesOnly yes
  ForwardAgent no
  IdentityFile ~/.ssh/id_github

# ==============================
# GITLAB
# ==============================
Host gitlab.com
  HostName gitlab.com
  Port 22
  IdentitiesOnly yes
  ForwardAgent no
  User git
  IdentityFile ~/.ssh/id_gitlab

