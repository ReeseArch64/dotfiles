# Exclusões globais do Git (desktop e notebook).
# Configuração: git config --global core.excludesFile ~/.gitignore
# Exceções devem permanecer depois dos padrões correspondentes.

# macOS
.DS_Store
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
.fseventsd
.DocumentRevisions-V100
.TemporaryItems
.VolumeIcon.icns
._*
Icon?

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump

# Linux e sistemas de arquivos
.fuse_hidden*
.directory
.nfs*
.Trash-*
lost+found/

# Editores e IDEs
.vscode/
.zed/
.cursor/
.kiro/
.idea/
.devin/
.history/
.vs/
*.VC.db
*.VC.opendb
*.suo
*.user
*.userosscache
*.sln.docstates
.metadata/
.recommenders/
*.sublime-workspace
*.kate-swp
*.save

# Vim, Neovim e Emacs
*.swp
*.swo
*.swn
Session.vim
.netrwhist
.nvimlog
\#*\#
.\#*

# Arquivos temporários, backups e resíduos de merge
*~
*.bak
*.tmp
*.tmp.*
*.temp
*.old
*.orig
*.rej
*.autosave
*.BASE.*
*.LOCAL.*
*.REMOTE.*
*.BACKUP.*

# Logs, diagnósticos e processos
logs/
.evlog/
*.log
*.trace
*.dmp
*.pid
*.pid.lock

# Variáveis de ambiente e segredos locais
.env
.env.*
!.env.example
.envrc
.direnv/
.kamal/secrets*
!.kamal/secrets
# Contém o segredo derivado de TUNNEL_TOKEN.
deploy/cloudflared-credentials.json

# Ambientes e versões locais de ferramentas
.venv/
venv/
.conda/
.conda_env/
.python-version
.nvmrc.local
.rbenv-version
.java-version

