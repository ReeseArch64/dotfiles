# Managed by dotfiles: homeprod-tunnel
[Unit]
Description=HomeProd Cloudflare Tunnel (CasaOS behind Access)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
DynamicUser=yes
LoadCredential=tunnel-token:/etc/homeprod-cloudflared/tunnel-token
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel --metrics 127.0.0.1:49312 run --token-file %d/tunnel-token
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
