# See https://git-scm.com/docs/git-config

[commit]
    gpgsign = true
    verbose = true

[init]
    defaultBranch = main

[pull]
    rebase = true
    ff = only

[push]
    autoSetupRemote = true
    default = current
    followTags = true

[fetch]
    prune = true
    pruneTags = true

[apply]
    whitespace = fix

[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
    renames = copies
    tool = vimdiff

[column]
    ui = auto

[branch]
    sort = -committerdate
    autosetuprebase = always

[tag]
    sort = -version:refname
    forceSignAnnotated = true

[rerere]
    enabled = true
    autoupdate = true

[core]
    excludesfile = ~/.gitignore
    attributesfile = ~/.gitattributes
    whitespace = space-before-tab,-indent-with-non-tab,trailing-space
    trustctime = false
    editor = vim
    pager = cat

[log]
    date = relative
    decorate = short

[worktree]
    prefix = ~/.worktrees/

[blame]
    date = short

[submodule]
    recurse = true

[color]
    ui = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red
    new = green

[color "status"]
    added = yellow
    changed = green
    untracked = cyan

[help]
    autocorrect = 10

[credential]
    helper = cache --timeout=3600

[merge]
    log = true
    tool = vimdiff
    conflictstyle = diff3
    ff = only

[rebase]
    autoStash = true
    autoSquash = true

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

[url "git@github.com:github"]
    insteadOf = https://github.com/github
    insteadOf = github:github
    insteadOf = git://github.com/github

[url "git@github.com:"]
    pushInsteadOf = https://github.com/
    pushInsteadOf = github:
    pushInsteadOf = git://github.com/

[url "git://github.com/"]
    insteadOf = github:

[url "git@gist.github.com:"]
    insteadOf = gst:
    pushInsteadOf = gist:
    pushInsteadOf = git://gist.github.com/

[url "git://gist.github.com/"]
    insteadOf = gist:

[alias]
    ci = commit
    co = checkout
    cm = checkout master
    cb = checkout -b
    st = status -sb
    sf = show --name-only
    lg = log --pretty=format:'%Cred%h%Creset %C(bold)%cr%Creset %Cgreen<%an>%Creset %s' --max-count=30
